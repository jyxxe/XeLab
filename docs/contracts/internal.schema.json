      ]
    },
    "BatchLeaseInput": {
      "type": "object",
      "description": "续约或提交均需匹配此租约",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "调用方关联键；不是行ID或授权凭证",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "当前fence"
