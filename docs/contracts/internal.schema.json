              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "openapi.json#/components/schemas/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lease",
        "state",
        "result",
        "error"
      ]
