          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "注册动作"
        },
        "resource": {
          "$ref": "./openapi.json#/components/schemas/ResourceSelector"
        },
        "outcome": {
          "enum": [
            "allowed",
            "denied",
            "succeeded",
            "failed"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "稳定原因码"
        }
      }
    },
    "SkillResolveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "input"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "UUID",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "input": {
          "$ref": "./openapi.json#/components/schemas/JsonValue"
        }
      }
    },
    "SkillResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "definition_digest",
        "target",
        "input_blob_ids",
        "binding_id",
        "installation_id"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "UUID",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "definition_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "description": "制品或内容 SHA-256 摘要",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "target": {
          "$ref": "./openapi.json#/components/schemas/SkillTarget"
        },
        "input_blob_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "description": "UUID",
            "format": "uuid",
            "example": "00000000-0000-4000-8000-000000000001"
          },
          "description": "当前请求获准 Blob 白名单",
          "minItems": 0,
          "maxItems": 256
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "UUID",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid",
          "description": "固定签名安装制品"
        }
      }
    },
    "SkillInvokeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
