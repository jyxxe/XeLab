    "BatchLease": {
      "type": "object",
      "description": "租约锁定输入与身份；原始令牌不入库",
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "调用方关联键；不是行ID或授权凭证",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "单调fence"
        },
        "lease_expires_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "创建时间，UTC",
          "format": "date-time",
          "example": "2026-10-28T12:00:00Z"
        },
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        "definition_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "description": "制品或内容 SHA-256 摘要",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "input": {
          "$ref": "openapi.json#/components/schemas/JsonValue"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "稳定业务键"
        }
      },
      "required": [
        "batch_id",
        "item_id",
        "execution_id",
        "fence",
        "lease_expires_at",
        "skill_id",
        "definition_digest",
        "input",
        "idempotency_key"
      ]
    },
    "BatchClaimResult": {
      "type": "object",
      "description": "有界领取结果，空数组表示暂时无任务",
