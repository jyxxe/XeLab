    "SecretLeaseInput": {
      "type": "object",
      "description": "工作负载取绑定密钥",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "requested_seconds"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "format": "uuid",
          "description": "绑定对象"
        },
        "requested_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      }
    },
    "SecretLeaseResult": {
      "type": "object",
      "description": "仅工作负载安全通道使用，不是 HTTP 用户返回值",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "value_base64",
        "secret_version",
        "expires_unix_ms"
      ],
      "properties": {
        "lease_id": {
          "type": "string",
          "format": "uuid",
          "description": "租约"
        },
        "value_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 87384,
          "description": "原值，解码最多 64 KiB，严禁日志/持久响应缓存"
        },
        "secret_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "密钥版本"
        },
        "expires_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "到期时刻"
        }
      }
    },
    "AuditAppendInput": {
      "type": "object",
      "description": "追加前已去除密码、token 和原始个人数据",
      "additionalProperties": false,
      "required": [
        "action",
        "resource",
        "outcome",
        "reason_code"
      ],
      "properties": {
