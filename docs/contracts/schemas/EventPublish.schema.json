{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventPublish",
  "type": "object",
  "description": "平台事件；业务数据必须匹配已注册主题契约",
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "主题命名空间"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "payload": {
      "$ref": "../openapi.json#/components/schemas/JsonValue"
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "发布去重键，最长保留 24h"
    }
  },
  "required": [
    "topic",
    "version",
    "payload",
    "dedupe_key"
  ]
}
