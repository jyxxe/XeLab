{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActivateAccount",
  "type": "object",
  "description": "激活待启用用户并设置密码",
  "additionalProperties": false,
  "properties": {
    "activation_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "一次性激活凭证"
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "description": "密码；12–128 字符，禁止截断",
      "writeOnly": true
    }
  },
  "required": [
    "activation_token",
    "password"
  ]
}
