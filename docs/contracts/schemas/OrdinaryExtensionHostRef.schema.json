{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrdinaryExtensionHostRef",
  "type": "object",
  "description": "普通OCI宿主的固定部署/安装/镜像摘要",
  "properties": {
    "kind": {
      "const": "ordinary"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "installation_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "精确Installation.image_digest，签名OCI来源与清单必须匹配",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "required": [
    "kind",
    "deployment_id",
    "installation_id",
    "installation_digest"
  ],
  "additionalProperties": false
}
