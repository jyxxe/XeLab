{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionManifest",
  "type": "object",
  "description": "独立扩展制品清单；contribution.json为有界严格JSON，不是OCI/可执行JS；旧宿主必须显式发布匹配扩展点",
  "properties": {
    "format_version": {
      "const": "1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "扩展用途"
    },
    "host_kind": {
      "type": "string",
      "enum": [
        "ordinary",
        "micro",
        "extension"
      ]
    },
    "point_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "精确匹配宿主扩展点",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "contract": {
      "$ref": "../openapi.json#/components/schemas/ContractRef"
    },
    "mode": {
      "type": "string",
      "enum": [
        "data",
        "skill"
      ]
    },
    "handler_skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "handler_definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "extension_points": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/ExtensionPoint"
      },
      "minItems": 0,
      "maxItems": 8
    }
  },
  "required": [
    "format_version",
    "version",
    "description",
    "host_kind",
    "point_id",
    "contract",
    "mode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "skill"
          }
        }
      },
      "then": {
        "required": [
          "handler_skill_id",
          "handler_definition_digest"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "handler_skill_id"
              ]
            },
            {
              "required": [
                "handler_definition_digest"
              ]
            }
          ]
        }
      }
    }
  ]
}
