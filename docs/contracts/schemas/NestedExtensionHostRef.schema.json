{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NestedExtensionHostRef",
  "type": "object",
  "description": "扩展作为宿主；须沿固定祖先链到真实ordinary或micro根，不接受回指或循环",
  "properties": {
    "kind": {
      "const": "extension"
    },
    "extension_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "extension_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "required": [
    "kind",
    "extension_deployment_id",
    "extension_version_id",
    "package_digest"
  ],
  "additionalProperties": false
}
