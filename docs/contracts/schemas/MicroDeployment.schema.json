{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroDeployment",
  "type": "object",
  "description": "微插件运行绑定；不创建OCI容器，候选Skill在此生成",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "micro_plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "micro_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "runtime_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "runtime_installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "limits": {
      "$ref": "../openapi.json#/components/schemas/MicroExecutionLimits"
    },
    "enabled": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "期望启停或资源/联网设置发生实质变更时递增；旧Prepare句柄和迟到执行不得覆盖新代次"
    },
    "phase": {
      "type": "string",
      "description": "观察状态；停用先进入draining，队列/Prepare/worker/句柄与组回收完成才disabled",
      "enum": [
        "disabled",
        "preparing",
        "ready",
        "draining",
        "waiting_runtime",
        "failed",
        "archived"
      ]
    },
    "reason_codes": {
      "type": "array",
      "description": "当前阻塞原因",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "原因"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "candidate_skill": {
      "$ref": "../openapi.json#/components/schemas/SkillDefinition"
    },
    "resources": {
      "$ref": "../openapi.json#/components/schemas/MicroResourceLimits"
    },
    "network_enabled": {
      "type": "boolean",
      "default": false,
      "description": "显式联网意图；true只允许已声明controlled-http-v1，仍须调用权限/HttpBinding/父egress；false拒绝HTTP profile Invoke与ProxyHttp"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "owner_id",
    "micro_plugin_id",
    "micro_version_id",
    "runtime_deployment_id",
    "runtime_installation_id",
    "package_digest",
    "limits",
    "enabled",
    "generation",
    "phase",
    "reason_codes",
    "candidate_skill",
    "resources",
    "network_enabled"
  ],
  "additionalProperties": false
}
