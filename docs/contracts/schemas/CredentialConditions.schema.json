{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialConditions",
  "type": "object",
  "description": "密钥附加条件，创建者源凭证条件也持续适用",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "必需的绝对到期时间，默认策略最大 365 天",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "source_cidrs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "CIDR"
      },
      "minItems": 1,
      "maxItems": 32,
      "description": "来源网段"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "接收服务 ID"
      },
      "minItems": 1,
      "maxItems": 32,
      "description": "目标服务"
    },
    "max_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "终生调用上限"
    }
  },
  "required": [
    "expires_at"
  ]
}
