{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroExtensionHostRef",
  "type": "object",
  "description": "微宿主精确部署/版本/微包；物理根由其固定MPR绑定解析",
  "properties": {
    "kind": {
      "const": "micro"
    },
    "micro_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "micro_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "required": [
    "kind",
    "micro_deployment_id",
    "micro_version_id",
    "package_digest"
  ],
  "additionalProperties": false
}
