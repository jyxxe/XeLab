{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateSkill",
  "type": "object",
  "description": "注册不可变Skill；普通来源须OCI签名覆盖，micro来源须核心候选与独立微制品匹配",
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "../openapi.json#/components/schemas/SkillDefinition"
    },
    "enabled": {
      "type": "boolean",
      "description": "安装不等于启用",
      "default": false
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "description": "普通Skill声明来源安装；micro Skill必须等于固定微版本的runtime_installation_id"
    }
  },
  "required": [
    "definition",
    "installation_id"
  ]
}
