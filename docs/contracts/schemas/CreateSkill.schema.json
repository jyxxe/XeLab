{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateSkill",
  "type": "object",
  "description": "注册不可变Skill；OCI清单、核心微候选或核心扩展候选分别核验，不能借宿主签名为后来上传制品背书",
  "additionalProperties": false,
  "properties": {
    "definition": {
      "$ref": "../openapi.json#/components/schemas/SkillDefinition"
    },
    "enabled": {
      "type": "boolean",
      "description": "安装不等于启用",
      "default": false
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "description": "实际物理rootOCI来源安装；micro为runtime安装，extension必须与固定宿主闭包root_installation_id相同，候选/包来源另核验"
    }
  },
  "required": [
    "definition",
    "installation_id"
  ]
}
