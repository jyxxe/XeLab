{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskStep",
  "type": "object",
  "description": "任务节点状态",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "step_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "WorkflowStep.id"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "succeeded",
        "failed",
        "canceled",
        "unknown"
      ],
      "description": "状态"
    },
    "provider_deployment_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        {
          "type": "null"
        }
      ],
      "description": "资源唯一标识"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "已创建尝试数量"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "task_id",
    "step_key",
    "state",
    "provider_deployment_id",
    "attempt_count"
  ]
}
