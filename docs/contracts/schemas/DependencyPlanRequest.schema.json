{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DependencyPlanRequest",
  "type": "object",
  "description": "解析不执行，计划有版本前置条件",
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    }
  },
  "required": [
    "deployment_id",
    "installation_id"
  ]
}
