{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelAliasSpec",
  "type": "object",
  "description": "内核批准的模型别名映射，不依赖插件私有配置推断",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "调用方使用的唯一模型别名",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "contract": {
      "$ref": "../openapi.json#/components/schemas/ContractRef"
    },
    "provider_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "固定提供者",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "context_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152,
      "description": "模型上下文 token 上限"
    },
    "maximum_output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32768,
      "description": "生成上限；embedding 为 0"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "skill_required 插件必需，须匹配既有 contract/provider 映射；本版仅ai能力目标，不接受micro或HTTP目标冒充AI适配",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "embedding_purpose": {
      "type": "string",
      "description": "文本兼容入口的固定前缀用途",
      "enum": [
        "retrieval_query",
        "retrieval_document",
        "semantic_similarity"
      ],
      "default": "semantic_similarity"
    }
  },
  "required": [
    "name",
    "contract",
    "provider_deployment_id",
    "context_tokens",
    "maximum_output_tokens"
  ]
}
