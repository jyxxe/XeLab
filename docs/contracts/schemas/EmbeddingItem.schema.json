{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmbeddingItem",
  "type": "object",
  "description": "向量输出",
  "additionalProperties": false,
  "properties": {
    "object": {
      "type": "string",
      "enum": [
        "embedding"
      ],
      "description": "类型"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127,
      "description": "与输入顺序一致"
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number",
        "description": "有限浮点数，不允许 NaN/Infinity"
      },
      "minItems": 1,
      "maxItems": 65536,
      "description": "向量维度由模型固定"
    }
  },
  "required": [
    "object",
    "index",
    "embedding"
  ]
}
