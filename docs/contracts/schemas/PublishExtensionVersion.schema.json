{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublishExtensionVersion",
  "type": "object",
  "description": "发布独立不可变清单与贡献；package_digest=SHA256(JCS({manifest,source_digest}))，不执行贡献或自动注册Skill",
  "properties": {
    "manifest": {
      "$ref": "../openapi.json#/components/schemas/ExtensionManifest"
    },
    "source_blob_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "当前blob.read获准的contribution.json，<=256KiB，复制到核心不可变存储，不依赖Blob TTL",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001",
      "x-xelab-resource-kind": "blob"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "required": [
    "manifest",
    "source_blob_id",
    "source_digest"
  ],
  "additionalProperties": false
}
