{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AckDelivery",
  "type": "object",
  "description": "只接受当前订阅与当前有效租约",
  "additionalProperties": false,
  "properties": {
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "lease_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "投递租约凭证"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ack",
        "retry",
        "dead_letter"
      ],
      "description": "ack 推进游标，retry 退避，dead_letter 停止本消息"
    }
  },
  "required": [
    "delivery_id",
    "lease_token",
    "outcome"
  ]
}
