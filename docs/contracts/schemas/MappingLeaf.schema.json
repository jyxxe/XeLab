{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MappingLeaf",
  "type": "object",
  "description": "输入映射叶子，三个分支严格互斥",
  "additionalProperties": false,
  "properties": {
    "literal": {
      "$ref": "../openapi.json#/components/schemas/JsonValue"
    },
    "task_input": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024,
      "description": "RFC6901 Pointer；空字符串表示整个输入"
    },
    "step_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "pointer"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "上游 step.id"
        },
        "pointer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "description": "RFC6901 Pointer"
        }
      }
    }
  },
  "required": [],
  "oneOf": [
    {
      "required": [
        "literal"
      ]
    },
    {
      "required": [
        "task_input"
      ]
    },
    {
      "required": [
        "step_output"
      ]
    }
  ],
  "maxProperties": 1
}
