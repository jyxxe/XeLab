{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretBindingSpec",
  "type": "object",
  "description": "仅批准指定部署使用指定密钥版本；不授予明文读取给用户",
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "secret_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "maximum_lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900,
      "description": "租约时长；不能撤回插件已经获知的原值",
      "default": 300
    }
  },
  "required": [
    "deployment_id",
    "secret_id",
    "maximum_lease_seconds"
  ]
}
