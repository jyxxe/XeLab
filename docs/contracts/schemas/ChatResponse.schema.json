{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatResponse",
  "type": "object",
  "description": "文本兼容接口非流式结果",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "chatcmpl_ + UUID"
    },
    "object": {
      "type": "string",
      "enum": [
        "chat.completion"
      ],
      "description": "对象类型"
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix 秒"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "模型别名"
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/ChatChoice"
      },
      "minItems": 1,
      "maxItems": 1,
      "description": "本版仅单个 choice"
    },
    "usage": {
      "$ref": "../openapi.json#/components/schemas/TokenUsage"
    }
  },
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices",
    "usage"
  ]
}
