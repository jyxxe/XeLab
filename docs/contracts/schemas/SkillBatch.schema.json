{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillBatch",
  "type": "object",
  "description": "核心持久化业务批次；不是管理Operation，也不要求创建Workflow",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "skill_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_dependency",
        "paused_authorization",
        "cancel_requested",
        "succeeded",
        "partially_succeeded",
        "failed",
        "canceled",
        "unknown"
      ],
      "description": "批次状态；unknown禁止盲重放"
    },
    "counts": {
      "$ref": "../openapi.json#/components/schemas/SkillBatchCounts"
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "实际配置的批次并行上限"
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "continue",
        "stop"
      ],
      "description": "逐项失败策略"
    },
    "run_as": {
      "type": "string",
      "enum": [
        "user",
        "service"
      ],
      "description": "实际执行主体模式"
    },
    "service_account_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "资源唯一标识",
          "format": "uuid",
          "example": "00000000-0000-4000-8000-000000000001"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "创建时间，UTC",
          "format": "date-time",
          "example": "2026-10-28T12:00:00Z"
        },
        {
          "type": "null"
        }
      ]
    },
    "results_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "创建时间，UTC",
          "format": "date-time",
          "example": "2026-10-28T12:00:00Z"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "../openapi.json#/components/schemas/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "owner_id",
    "subject_id",
    "delegation_id",
    "skill_id",
    "skill_version",
    "definition_digest",
    "installation_id",
    "state",
    "counts",
    "max_parallel",
    "failure_policy",
    "run_as",
    "service_account_id",
    "deadline_at",
    "completed_at",
    "results_expires_at",
    "error"
  ]
}
