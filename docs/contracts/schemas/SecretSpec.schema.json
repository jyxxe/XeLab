{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretSpec",
  "type": "object",
  "description": "创建平台托管密钥；仅首次写入，不提供用户明文读取端点",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "名称"
    },
    "value_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 87384,
      "description": "Base64 编码内容，解码后最多 64 KiB",
      "writeOnly": true
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "外部凭证过期时间",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    }
  },
  "required": [
    "name",
    "value_base64"
  ]
}
