{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery",
  "type": "object",
  "description": "至少一次事件投递",
  "additionalProperties": false,
  "properties": {
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "subscription_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "event": {
      "$ref": "../openapi.json#/components/schemas/Event"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "本次序号"
    },
    "lease_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "确认租约令牌，不可写入普通日志"
    },
    "lease_expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "确认期限，默认 30s",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    }
  },
  "required": [
    "delivery_id",
    "subscription_id",
    "event",
    "attempt",
    "lease_token",
    "lease_expires_at"
  ]
}
