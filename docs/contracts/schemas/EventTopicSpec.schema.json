{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventTopicSpec",
  "type": "object",
  "description": "插件声明的事件主题契约",
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "必须位于 plugin_id 命名空间内"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "payload_schema": {
      "$ref": "../openapi.json#/components/schemas/JsonValue"
    },
    "schema_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "required": [
    "topic",
    "version",
    "payload_schema",
    "schema_digest"
  ]
}
