{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorDetail",
  "type": "object",
  "description": "稳定错误对象",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "错误码；取值见错误目录"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "安全且不含敏感信息的说明"
    },
    "retryable": {
      "type": "boolean",
      "description": "是否允许按重试规则再次提交"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/FieldViolation"
      },
      "minItems": 0,
      "maxItems": 256,
      "description": "字段校验错误"
    },
    "retry_after_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000,
          "description": "建议退避时间，毫秒"
        },
        {
          "type": "null"
        }
      ],
      "description": "建议退避时间，毫秒"
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "可选非敏感资源引用；一次性签发重放供核实使用"
        },
        {
          "type": "null"
        }
      ],
      "description": "可选非敏感资源引用；一次性签发重放供核实使用"
    }
  },
  "required": [
    "code",
    "message",
    "retryable",
    "violations",
    "retry_after_ms"
  ]
}
