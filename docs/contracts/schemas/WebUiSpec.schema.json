{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebUiSpec",
  "type": "object",
  "description": "浏览器界面元数据",
  "additionalProperties": false,
  "properties": {
    "base_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "平台内部转发路径"
    },
    "entry_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "容器内 HTTP 页面路径"
    },
    "management_api_major": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "兼容管理 API 主版本，当前为 1"
    },
    "isolation": {
      "type": "string",
      "enum": [
        "dedicated_origin",
        "sandbox"
      ],
      "description": "非互信 UI 必须独立源或 sandbox"
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "显式来源仍必须与平台为该固定部署分配的 HTTPS origin 完全相同，不能指定内核或其他插件域"
        },
        {
          "type": "null"
        }
      ],
      "description": "null 请求平台按固定 deployment_id 分配独立 HTTPS origin；非空只能精确匹配该分配值。签名制品不预知新部署 UUID，也不得指定可信内核域或其他插件域。"
    }
  },
  "required": [
    "base_path",
    "entry_path",
    "management_api_major",
    "isolation",
    "origin"
  ]
}
