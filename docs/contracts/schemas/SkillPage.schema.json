{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillPage",
  "type": "object",
  "description": "可见 Skill 版本列表",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/Skill"
      },
      "description": "对象",
      "minItems": 0,
      "maxItems": 200
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "15min 有效的不透明游标"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ]
}
