{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestoreRequest",
  "type": "object",
  "description": "恢复到新卷，默认不覆盖原卷",
  "additionalProperties": false,
  "properties": {
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "target_deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "allow_downtime": {
      "type": "boolean",
      "description": "必须明确允许停止目标部署"
    }
  },
  "required": [
    "backup_id",
    "target_deployment_id",
    "allow_downtime"
  ]
}
