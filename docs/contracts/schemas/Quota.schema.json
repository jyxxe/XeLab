{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quota",
  "type": "object",
  "description": "账户树预算及当前使用",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "spec": {
      "$ref": "../openapi.json#/components/schemas/QuotaSpec"
    },
    "descendants_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "当前后代数"
    },
    "api_keys_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "有效密钥数"
    },
    "concurrent_calls_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "当前并发"
    },
    "daily_calls_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "UTC 当日累计"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "account_id",
    "spec",
    "descendants_used",
    "api_keys_used",
    "concurrent_calls_used",
    "daily_calls_used"
  ]
}
