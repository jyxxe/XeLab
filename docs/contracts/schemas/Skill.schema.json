{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill",
  "type": "object",
  "description": "Skill 版本与当前可用性",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "definition": {
      "$ref": "../openapi.json#/components/schemas/SkillDefinition"
    },
    "definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "enabled": {
      "type": "boolean",
      "description": "期望启用状态"
    },
    "availability": {
      "type": "string",
      "description": "健康/依赖/审批过滤结果",
      "enum": [
        "ready",
        "unavailable",
        "disabled"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "稳定原因"
      },
      "description": "不可用原因",
      "minItems": 0,
      "maxItems": 32
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "description": "普通Skill声明来源安装；micro Skill必须等于固定微版本的runtime_installation_id"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "definition",
    "definition_digest",
    "enabled",
    "availability",
    "reason_codes",
    "installation_id"
  ]
}
