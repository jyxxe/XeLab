{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OAuthToken",
  "type": "object",
  "description": "标准 OAuth token 响应；访问令牌绑定 subject/client/audience",
  "additionalProperties": false,
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Bearer 令牌"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "Bearer"
      ],
      "description": "类型"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 900,
      "maximum": 900,
      "description": "秒，固定 900"
    },
    "refresh_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "可选轮换凭证，最长 24h"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "空格分隔且排序去重的预注册句柄：client:<public_client_id> 表示该 Client 注册的 maximum_rules 上限；rule:sha256:<RFC8785规则摘要> 表示该 Client 上限中的单条规则。绑定当前 Client revision，并与当前会话权限交集后冻结原始来源；不得解析任意规则或动态最新版。"
    }
  },
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "scope"
  ]
}
