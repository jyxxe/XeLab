{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginApproval",
  "type": "object",
  "description": "发布版本获批权限与外部网络访问；不是用户授权",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/PermissionRule"
      },
      "minItems": 0,
      "maxItems": 256,
      "description": "插件代理权限上限"
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "允许的 https://host:port；主机需逐次解析和校验，禁止隐式内网"
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "出口白名单"
    }
  },
  "required": [
    "rules",
    "egress"
  ]
}
