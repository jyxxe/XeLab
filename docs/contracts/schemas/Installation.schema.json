{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installation",
  "type": "object",
  "description": "安装记录；与部署和实例状态分离",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "插件稳定 ID；不含版本",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "example": "org.xelab.echo"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "image_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "manifest": {
      "$ref": "../openapi.json#/components/schemas/Manifest"
    },
    "state": {
      "type": "string",
      "enum": [
        "validated",
        "installed",
        "uninstalling",
        "uninstalled",
        "failed"
      ],
      "description": "安装状态"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "plugin_id",
    "version",
    "image_digest",
    "manifest",
    "state"
  ]
}
