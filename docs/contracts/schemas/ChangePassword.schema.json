{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangePassword",
  "type": "object",
  "description": "用户本人修改密码；服务账户不支持",
  "additionalProperties": false,
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "当前密码",
      "writeOnly": true
    },
    "new_password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "description": "新密码，12–128 字符",
      "writeOnly": true
    }
  },
  "required": [
    "current_password",
    "new_password"
  ]
}
