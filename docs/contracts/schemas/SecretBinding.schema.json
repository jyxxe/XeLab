{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretBinding",
  "type": "object",
  "description": "密钥到工作负载的绑定",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "spec": {
      "$ref": "../openapi.json#/components/schemas/SecretBindingSpec"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "description": "状态"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "spec",
    "status"
  ]
}
