{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateExtensionPlugin",
  "type": "object",
  "description": "owner取当前主体，name在owner命名空间唯一；身份创建不安装宿主或加载贡献",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "稳定名称，创建后不变",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "example": "json-echo"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "普通文本显示名"
    }
  },
  "required": [
    "name",
    "display_name"
  ],
  "additionalProperties": false
}
