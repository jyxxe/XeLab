{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelAlias",
  "type": "object",
  "description": "对调用者可见的模型别名",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "模型别名"
    },
    "object": {
      "type": "string",
      "enum": [
        "model"
      ],
      "description": "对象类型"
    },
    "owned_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "发布者显示名称"
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Unix 秒"
    }
  },
  "required": [
    "id",
    "object",
    "owned_by",
    "created"
  ]
}
