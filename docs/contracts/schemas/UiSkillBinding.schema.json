{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UiSkillBinding",
  "type": "object",
  "description": "构建期声明允许桥接的Skill；安装后解析为精确UUID/digest，不使用latest",
  "additionalProperties": false,
  "properties": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "贡献内唯一别名",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "插件命名空间内唯一名称，plugin_id 前缀",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
      "example": "1.0.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "call",
          "batch"
        ],
        "description": "方式"
      },
      "minItems": 1,
      "maxItems": 2,
      "description": "允许的宿主桥方法；未声明默认全部禁止",
      "uniqueItems": true
    }
  },
  "required": [
    "alias",
    "name",
    "version",
    "modes"
  ]
}
