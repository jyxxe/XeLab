{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionPluginVersion",
  "type": "object",
  "description": "发布后不可变；JSON贡献与清单按独立owner/来源/包摘要核验，宿主在部署时精确绑定",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "manifest": {
      "$ref": "../openapi.json#/components/schemas/ExtensionManifest"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144,
      "description": "contribution.json原始UTF8字节数，严格JSON/无NUL/BOM/重复key，深度<=32"
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "制品或内容 SHA-256 摘要",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "extension_plugin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    }
  },
  "required": [
    "id",
    "extension_plugin_id",
    "created_at",
    "manifest",
    "source_digest",
    "source_bytes",
    "package_digest"
  ],
  "additionalProperties": false
}
