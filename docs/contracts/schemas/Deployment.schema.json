{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment",
  "type": "object",
  "description": "期望状态及控制器观察结果",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "spec": {
      "$ref": "../openapi.json#/components/schemas/DeploymentSpec"
    },
    "observed_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "已处理的期望版本"
    },
    "phase": {
      "type": "string",
      "enum": [
        "disabled",
        "waiting_resources",
        "reconciling",
        "ready",
        "degraded",
        "failed",
        "draining"
      ],
      "description": "部署聚合状态"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "稳定条件码"
      },
      "minItems": 0,
      "maxItems": 32,
      "description": "当前阻塞/降级原因"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "spec",
    "observed_generation",
    "phase",
    "conditions"
  ]
}
