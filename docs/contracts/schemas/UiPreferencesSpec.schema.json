{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UiPreferencesSpec",
  "type": "object",
  "description": "当前账户跨登录保留的非敏感偏好；不允许存令牌/业务输入/结果",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "$ref": "../openapi.json#/components/schemas/UiThemeSpec"
    },
    "dock": {
      "$ref": "../openapi.json#/components/schemas/UiDockSpec"
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "../openapi.json#/components/schemas/UiWidgetPlacement"
      },
      "minItems": 0,
      "maxItems": 32,
      "description": "桌面组件布局；初始为空，不默认后台运行"
    },
    "restore_windows": {
      "type": "boolean",
      "default": true,
      "description": "是否恢复本浏览器中同用户窗口位置；不自动重放调用"
    }
  },
  "required": [
    "theme",
    "dock",
    "widgets",
    "restore_windows"
  ]
}
