{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CallStatus",
  "type": "object",
  "description": "调用状态与结果查询",
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "canceled",
        "unknown"
      ],
      "description": "unknown 不能直接视为失败重试"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "../openapi.json#/components/schemas/CallResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "可为空"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "../openapi.json#/components/schemas/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "description": "可为空"
    }
  },
  "required": [
    "call_id",
    "state",
    "result",
    "error"
  ]
}
