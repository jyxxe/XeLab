{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session",
  "type": "object",
  "description": "会话元数据，不返回校验摘要",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "乐观锁版本，每次持久化变更加一"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "创建时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近变更时间，UTC",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "资源唯一标识",
      "format": "uuid",
      "example": "00000000-0000-4000-8000-000000000001"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "可信客户端 ID"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "绝对过期时间",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "last_seen_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "最近验证时间",
      "format": "date-time",
      "example": "2026-10-28T12:00:00Z"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "description": "会话状态"
    }
  },
  "required": [
    "id",
    "revision",
    "created_at",
    "updated_at",
    "account_id",
    "client_id",
    "expires_at",
    "last_seen_at",
    "status"
  ]
}
