{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeConfig",
  "type": "object",
  "description": "本机资源预算；内核最低预留不能调低",
  "additionalProperties": false,
  "properties": {
    "kernel_cpu_millis": {
      "type": "integer",
      "minimum": 4000,
      "maximum": 1048576,
      "description": "内核预留，至少 4 vCPU",
      "default": 4000
    },
    "kernel_memory_bytes": {
      "type": "integer",
      "minimum": 17179869184,
      "maximum": 9007199254740991,
      "description": "内核预留，至少 16 GiB",
      "default": 17179869184
    },
    "system_cpu_millis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "description": "宿主/独立基础设施预留，必须显式配置"
    },
    "system_memory_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 9007199254740991,
      "description": "宿主/基础设施预留，必须显式配置"
    },
    "shutdown_grace_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "description": "内核停止最大排空时间",
      "default": 30000
    }
  },
  "required": [
    "kernel_cpu_millis",
    "kernel_memory_bytes",
    "system_cpu_millis",
    "system_memory_bytes",
    "shutdown_grace_ms"
  ]
}
