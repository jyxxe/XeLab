{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeConfig",
  "type": "object",
  "description": "本机资源预算；profile 省略为 standard，compact 为整机至少 1 vCPU/512 MiB 的低并发档位；稳定性须另行宿主验收。",
  "additionalProperties": false,
  "properties": {
    "kernel_cpu_millis": {
      "type": "integer",
      "minimum": 500,
      "maximum": 1048576,
      "description": "内核预留；compact 至少 500mCPU，standard 至少 4000mCPU",
      "default": 4000
    },
    "kernel_memory_bytes": {
      "type": "integer",
      "minimum": 201326592,
      "maximum": 9007199254740991,
      "description": "内核预留；compact 至少 192MiB，standard 至少 16GiB",
      "default": 17179869184
    },
    "system_cpu_millis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "description": "宿主/独立基础设施预留，必须显式配置"
    },
    "system_memory_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 9007199254740991,
      "description": "宿主/基础设施预留，必须显式配置"
    },
    "shutdown_grace_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000,
      "description": "内核停止最大排空时间",
      "default": 30000
    },
    "profile": {
      "type": "string",
      "enum": [
        "standard",
        "compact"
      ],
      "default": "standard",
      "description": "新节点初始化时固定的资源档位；已有节点不可在线或仅改配置切换，显式迁移尚未提供；旧配置保持 standard。"
    }
  },
  "required": [
    "kernel_cpu_millis",
    "kernel_memory_bytes",
    "system_cpu_millis",
    "system_memory_bytes",
    "shutdown_grace_ms"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "compact"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "system_cpu_millis": {
            "minimum": 250
          },
          "system_memory_bytes": {
            "minimum": 268435456
          }
        }
      },
      "else": {
        "properties": {
          "kernel_cpu_millis": {
            "minimum": 4000
          },
          "kernel_memory_bytes": {
            "minimum": 17179869184
          }
        }
      }
    }
  ]
}
