{
  "name": "org.xelab.knowledge-base.table-drop",
  "version": "2.0.0",
  "description": "销毁知识表和所属数据",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "显式销毁",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "expected_schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "CAS，创建/删除等另见语义"
      },
      "confirm_table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "必须等于 table_id",
        "format": "uuid"
      }
    },
    "required": [
      "table_id",
      "expected_schema_revision",
      "confirm_table_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "有版本的变更结果",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "当前版本"
      },
      "data_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "当前数据版本"
      },
      "affected_rows": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "影响行数"
      }
    },
    "required": [
      "table_id",
      "schema_revision",
      "data_revision",
      "affected_rows"
    ],
    "additionalProperties": false
  },
  "stream_item_schema": null,
  "target": {
    "kind": "capability",
    "plugin_id": "org.xelab.knowledge-base",
    "contract": {
      "name": "data.kb.table.drop",
      "version": "1.0.0",
      "schema_digest": "sha256:9a3cba855020c08f4a8223ef672e8d0fe0be9498ef91a876ad98fffcd5120bd1"
    }
  },
  "mapping": "identity",
  "maximum_timeout_ms": 300000,
  "input_blobs": false,
  "tags": [
    "preset",
    "knowledge-base"
  ]
}
