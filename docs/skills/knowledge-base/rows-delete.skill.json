{
  "name": "org.xelab.knowledge-base.rows-delete",
  "version": "2.0.0",
  "description": "删除明确行集合",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "无表达式批量删除",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "expected_schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "CAS，创建/删除等另见语义"
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "目标版本",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "description": "UUID",
              "format": "uuid"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "行版本"
            }
          },
          "required": [
            "id",
            "expected_revision"
          ],
          "additionalProperties": false
        },
        "description": "最多64行",
        "minItems": 1,
        "maxItems": 64
      }
    },
    "required": [
      "table_id",
      "expected_schema_revision",
      "rows"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "有版本的变更结果",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "当前版本"
      },
      "data_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "当前数据版本"
      },
      "affected_rows": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "影响行数"
      }
    },
    "required": [
      "table_id",
      "schema_revision",
      "data_revision",
      "affected_rows"
    ],
    "additionalProperties": false
  },
  "stream_item_schema": null,
  "target": {
    "kind": "capability",
    "plugin_id": "org.xelab.knowledge-base",
    "contract": {
      "name": "data.kb.rows.delete",
      "version": "1.0.0",
      "schema_digest": "sha256:c9b891f24a0de955a41ddbc7848cc327066b74fca51f30a31273644e8408dd23"
    }
  },
  "mapping": "identity",
  "maximum_timeout_ms": 300000,
  "input_blobs": false,
  "tags": [
    "preset",
    "knowledge-base"
  ]
}
