{
  "name": "org.xelab.knowledge-base.vector-reindex",
  "version": "2.0.0",
  "description": "有界批量更新待索引行",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "每次请求独立有效授权",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "field_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "字段 ID，不随列重命名改变",
        "format": "uuid"
      },
      "generation": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "必须与当前配置一致"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "description": "本批最多128行",
        "default": 32
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "可选续点"
      }
    },
    "required": [
      "table_id",
      "field_id",
      "generation"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "进度",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "field_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "字段 ID，不随列重命名改变",
        "format": "uuid"
      },
      "generation": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "配置代次"
      },
      "processed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 128,
        "description": "本批处理数"
      },
      "failed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 128,
        "description": "本批失败数"
      },
      "pending_rows": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991,
        "description": "剩余待处理"
      },
      "next_cursor": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "下一批提示，重查仍需当前授权"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "table_id",
      "field_id",
      "generation",
      "processed",
      "failed",
      "pending_rows",
      "next_cursor"
    ],
    "additionalProperties": false
  },
  "stream_item_schema": null,
  "target": {
    "kind": "capability",
    "plugin_id": "org.xelab.knowledge-base",
    "contract": {
      "name": "data.kb.vector.reindex",
      "version": "1.0.0",
      "schema_digest": "sha256:1d9543c7789dd309e6e2af7f3f228917c098da1aaf69a80005c6f9fb605a2979"
    }
  },
  "mapping": "identity",
  "maximum_timeout_ms": 300000,
  "input_blobs": false,
  "tags": [
    "preset",
    "knowledge-base"
  ]
}
