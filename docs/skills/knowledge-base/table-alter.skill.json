              },
              "required": [
                "op",
                "field_id",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "删列，显式数据删除",
              "properties": {
                "op": {
                  "const": "drop_field"
                },
                "field_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "description": "字段 ID，不随列重命名改变",
                  "format": "uuid"
                },
                "confirm_drop_data": {
                  "const": true
                }
              },
              "required": [
                "op",
                "field_id",
                "confirm_drop_data"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "description": "批准索引维护身份",
              "properties": {
                "op": {
                  "const": "set_indexer"
