                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 36,
                      "description": "UUID",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "op",
                "account_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "description": "有序变更，最多 16",
        "minItems": 1,
        "maxItems": 16
      }
    },
    "required": [
      "table_id",
      "expected_schema_revision",
      "actions"
    ],
    "additionalProperties": false
  },
