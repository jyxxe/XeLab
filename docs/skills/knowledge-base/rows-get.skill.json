{
  "name": "org.xelab.knowledge-base.rows-get",
  "version": "1.0.0",
  "description": "按完整ID列表中的明确1..200个ID读取全部行正文",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "按明确ID读取1..200行，不执行表达式或隐式分页",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "ids": {
        "type": "array",
        "description": "全部必须存在，重复拒绝",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "UUID",
          "format": "uuid"
        },
        "minItems": 1,
        "maxItems": 200,
        "uniqueItems": true
      },
      "projection": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "description": "ASCII 列名；下划线开头留给系统",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,62}$"
        },
        "description": "省略表示全部列",
        "minItems": 1,
        "maxItems": 128,
        "uniqueItems": true
      },
      "expected_schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "可选快照前置；两个expected水位必须成对"
      },
      "expected_data_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "快照水位"
      }
    },
    "required": [
      "table_id",
      "ids"
    ],
    "additionalProperties": false,
    "dependentRequired": {
      "expected_schema_revision": [
        "expected_data_revision"
      ],
      "expected_data_revision": [
        "expected_schema_revision"
      ]
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "完整返回请求的所有行；任何missing/水位不符拒绝整次",
    "properties": {
      "table_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "description": "UUID",
        "format": "uuid"
      },
      "schema_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "快照水位"
      },
      "data_revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "description": "快照水位"
      },
      "items": {
        "type": "array",
        "description": "按输入ID顺序，长度必须与请求ids相同",
        "items": {
          "type": "object",
          "description": "行正文；顺序与请求ids严格一致",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "description": "UUID",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "行版本"
            },
            "values": {
              "type": "object",
              "description": "只含投影列",
              "additionalProperties": {
                "type": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "boolean",
                  "null"
                ],
                "description": "业务 JSON，按数据列类型继续校验"
              },
              "maxProperties": 128
            }
          },
          "required": [
            "id",
            "revision",
            "values"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 200
      }
    },
    "required": [
      "table_id",
      "schema_revision",
      "data_revision",
      "items"
    ],
    "additionalProperties": false
  },
  "stream_item_schema": null,
  "target": {
    "kind": "capability",
    "plugin_id": "org.xelab.knowledge-base",
    "contract": {
      "name": "data.kb.rows.get",
      "version": "1.0.0",
      "schema_digest": "sha256:550f63f2183313cd999750e7875ecb16207a03f860116d9407ce49233f264233"
    }
  },
  "mapping": "identity",
  "maximum_timeout_ms": 300000,
  "input_blobs": false,
  "tags": [
    "preset",
    "knowledge-base"
  ]
}
