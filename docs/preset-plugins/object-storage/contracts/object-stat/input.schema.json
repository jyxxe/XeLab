{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "本用户完整key元数据",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "NFC逻辑key，UTF8<=1024字节；拒绝首尾斜线/空段/dot段/控制符/反斜线，不作URL decode",
      "pattern": "^[^\u0000-\u001f\\\\]+$",
      "example": "reports/example.txt"
    }
  },
  "required": [
    "key"
  ],
  "additionalProperties": false
}
