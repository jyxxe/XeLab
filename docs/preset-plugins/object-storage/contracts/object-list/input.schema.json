{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "本用户前缀列表，按UTF8字节序分页当前视图",
  "properties": {
    "prefix": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1024,
      "default": "",
      "description": "NFC UTF8字节前缀，允许空和末尾/；不解析为文件系统路径"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "每页对象数",
      "default": 50
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "15min不透明游标，绑定subject/prefix/数据域"
    }
  },
  "required": [],
  "additionalProperties": false
}
