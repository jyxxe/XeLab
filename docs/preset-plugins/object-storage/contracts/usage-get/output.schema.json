{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "本用户逻辑量和预留，不公开其他用户用量",
  "properties": {
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "logical_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "已发布可见内容字节"
    },
    "reserved_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "进行中的写入逻辑预留"
    },
    "object_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "可见对象个数"
    },
    "quota_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "本人逻辑字节上限"
    },
    "max_objects": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "本人可见对象数量上限"
    }
  },
  "required": [
    "owner_id",
    "logical_bytes",
    "reserved_bytes",
    "object_count",
    "quota_bytes",
    "max_objects"
  ],
  "additionalProperties": false
}
