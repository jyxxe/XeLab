{
  "status": "planned",
  "version": "0.1.0",
  "kind": "micro",
  "capability_id": "data.group",
  "side_effect": "none",
  "maximum_input_bytes": 1048576,
  "maximum_output_bytes": 1048576,
  "maximum_json_depth": 64,
  "streaming": false,
  "batch": "core_async_skill_batch",
  "unknown_fields": "reject",
  "authorization": "future_micro_skill_and_micro_resource_and_runtime",
  "cancellation": "cooperative_hard_deadline_no_partial_success",
  "retries": "bounded_same_definition_same_deadline",
  "feature_gates": [
    "typed-compare-library",
    "json-pointer-library"
  ],
  "notes": [
    "Group order first-seen; missing skip drops record explicitly, group-null distinct from error.",
    "Exceed group/memory/output bound is whole failure.",
    "Each group key is a scalar tuple with the same length/order as input.keys; group_count equals groups.length; all item/indices mappings are exact."
  ],
  "deployment_defaults": {
    "resources": {
      "cpu_millis": 250,
      "memory_bytes": 268435456
    },
    "network_enabled": false
  },
  "resource_scope": "aggregate_micro_deployment_cgroup"
}
