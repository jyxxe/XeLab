{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-xelab-status": "planned",
  "type": "object",
  "description": "",
  "properties": {
    "data": {
      "type": "string",
      "description": "严格base64字节，不是宿主路径",
      "minLength": 0,
      "maxLength": 1048576
    },
    "from": {
      "type": "string",
      "enum": [
        "utf-8",
        "utf-16le",
        "utf-16be"
      ],
      "description": ""
    },
    "to": {
      "type": "string",
      "enum": [
        "utf-8",
        "utf-16le",
        "utf-16be"
      ],
      "description": ""
    },
    "errors": {
      "type": "string",
      "enum": [
        "strict",
        "replace"
      ],
      "description": "",
      "default": "strict"
    },
    "bom": {
      "type": "string",
      "enum": [
        "omit",
        "emit"
      ],
      "description": "",
      "default": "omit"
    }
  },
  "required": [
    "data",
    "from",
    "to"
  ],
  "additionalProperties": false
}
