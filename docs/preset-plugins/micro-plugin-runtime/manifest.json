{
  "manifest_version": "1",
  "plugin_id": "org.xelab.micro-plugin-runtime",
  "version": "1.3.0",
  "publisher_id": "00000000-0000-4000-8000-000000000001",
  "host_api_major": 1,
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "entrypoint": [
    "/usr/local/bin/plugin"
  ],
  "capabilities": [],
  "dependencies": [],
  "requested_rules": [
    {
      "rule": {
        "action": "micro.http.request",
        "resource": {
          "kind": "micro_plugin",
          "match": "all"
        }
      },
      "required": false
    },
    {
      "rule": {
        "action": "skill.invoke",
        "resource": {
          "kind": "skill",
          "match": "all"
        }
      },
      "required": false
    }
  ],
  "minimum_resources": {
    "cpu_millis": 1000,
    "memory_bytes": 1073741824,
    "ephemeral_bytes": 268435456,
    "pids": 128
  },
  "health": {
    "startup_timeout_ms": 180000,
    "interval_ms": 5000,
    "timeout_ms": 2000,
    "failure_threshold": 3
  },
  "volumes": [],
  "routes": [],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "仅受限JS；默认资源建议尚需实现实测",
    "properties": {
      "engine": {
        "const": "javascript"
      },
      "protocol": {
        "const": "json-stdio-v1"
      },
      "maximum_active_requests": {
        "const": 4
      },
      "maximum_queue_requests": {
        "const": 32
      },
      "queue_timeout_ms": {
        "const": 5000
      },
      "artifact_cache_max_bytes": {
        "type": "integer",
        "minimum": 1048576,
        "maximum": 536870912,
        "default": 268435456,
        "description": "v1准备执行依赖缓存驻留，配置范围1..512MiB；容量不足明确拒绝Prepare，不能无限重准备"
      },
      "artifact_cache_max_entries": {
        "const": 128
      },
      "artifact_cache_ttl_seconds": {
        "const": 300
      },
      "worker_address_space_bytes": {
        "type": "integer",
        "minimum": 268435456,
        "maximum": 34359738368,
        "default": 1073741824,
        "description": "单worker虚拟地址空间额外界限，不是RSS或CPU隔离"
      },
      "maximum_sandbox_bytes": {
        "type": "integer",
        "minimum": 67108864,
        "maximum": 17179869184,
        "default": 3758096384,
        "description": "所有活跃微部署资源组的内存准入池/父工作负载memory.max"
      },
      "control_memory_reserve_bytes": {
        "type": "integer",
        "minimum": 67108864,
        "maximum": 4294967296,
        "default": 134217728,
        "description": "监督器开销预留，另加artifact_cache_max_bytes，二者进入control子组"
      },
      "maximum_sandbox_cpu_millis": {
        "type": "integer",
        "minimum": 10,
        "maximum": 64000,
        "default": 3500,
        "description": "所有活跃微部署CPU准入池及workloads父cpu.max"
      },
      "control_cpu_reserve_millis": {
        "type": "integer",
        "minimum": 100,
        "maximum": 8000,
        "default": 500,
        "description": "监督器control子组CPU预留/硬限额；与工作池合计不得超过MPR父限额"
      }
    },
    "required": [
      "engine",
      "protocol",
      "maximum_active_requests",
      "maximum_queue_requests",
      "queue_timeout_ms",
      "artifact_cache_max_bytes",
      "artifact_cache_max_entries",
      "artifact_cache_ttl_seconds",
      "worker_address_space_bytes",
      "maximum_sandbox_bytes",
      "control_memory_reserve_bytes",
      "maximum_sandbox_cpu_millis",
      "control_cpu_reserve_millis"
    ],
    "additionalProperties": false
  },
  "data_schema_version": "none",
  "upgrade_strategy": "recreate",
  "skills": [],
  "business_entry": "skill_required",
  "concurrency": {
    "max_active_requests": 4,
    "max_queue_requests": 32,
    "queue_timeout_ms": 5000
  },
  "micro_runtime": {
    "api_major": 1,
    "engines": [
      "javascript"
    ],
    "protocols": [
      "json-stdio-v1"
    ],
    "execution_profiles": [
      "pure-json-v1",
      "controlled-http-v1"
    ],
    "resource_isolation": "cgroup-v2-per-micro-deployment-v1"
  },
  "extension_host": {
    "api_major": 1,
    "host_kinds": [
      "micro",
      "extension"
    ],
    "modes": [
      "data",
      "skill"
    ],
    "maximum_chain_depth": 16
  }
}
