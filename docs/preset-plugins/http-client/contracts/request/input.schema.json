{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-xelab-status": "planned",
  "type": "object",
  "description": "",
  "properties": {
    "policy_alias": {
      "type": "string",
      "description": "固定批准的连接/路由别名",
      "minLength": 1,
      "maxLength": 128
    },
    "url": {
      "type": "string",
      "description": "每跳DNS/地址/策略校验",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "description": "",
      "default": "GET"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "非敏感头，敏感/逐跳头由实现拒绝",
        "minLength": 0,
        "maxLength": 4096
      },
      "maxProperties": 32
    },
    "body_text": {
      "type": "string",
      "description": "",
      "minLength": 0,
      "maxLength": 1048576
    },
    "body_blob_id": {
      "type": "string",
      "description": "UUID",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid",
      "x-xelab-resource-kind": "blob"
    },
    "content_type": {
      "type": "string",
      "description": "",
      "minLength": 1,
      "maxLength": 128
    },
    "response_mode": {
      "type": "string",
      "enum": [
        "json",
        "text",
        "blob"
      ],
      "description": "",
      "default": "json"
    },
    "timeout_ms": {
      "type": "integer",
      "description": "",
      "minimum": 100,
      "maximum": 120000,
      "default": 30000
    },
    "max_response_bytes": {
      "type": "integer",
      "description": "",
      "minimum": 1,
      "maximum": 67108864,
      "default": 1048576
    }
  },
  "required": [
    "policy_alias",
    "url"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": [
          "body_text",
          "body_blob_id"
        ]
      }
    }
  ]
}
