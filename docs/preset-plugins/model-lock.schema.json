{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_repository",
    "model_revision",
    "tokenizer_revision",
    "processor_revision",
    "artifacts",
    "runtime",
    "dtype",
    "quantization",
    "text_encoder_fingerprint",
    "projection_fingerprint",
    "prefix_policy_version",
    "normalization"
  ],
  "properties": {
    "model_repository": {
      "const": "google/embeddinggemma-2"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tokenizer_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "processor_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "size_bytes",
          "digest"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "制品内规范相对路径，运行时拒绝绝对路径、点段、符号链接逃逸"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "version"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "dtype": {
      "const": "float32"
    },
    "quantization": {
      "const": "none"
    },
    "text_encoder_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "projection_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prefix_policy_version": {
      "const": "xelab-embedding-prefix-v1"
    },
    "normalization": {
      "const": "truncate_then_l2_v1"
    }
  }
}
