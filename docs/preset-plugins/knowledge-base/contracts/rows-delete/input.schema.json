{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "无表达式批量删除",
  "properties": {
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "expected_schema_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "CAS，创建/删除等另见语义"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "目标版本",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "description": "UUID",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "行版本"
          }
        },
        "required": [
          "id",
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "description": "最多64行",
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "table_id",
    "expected_schema_revision",
    "rows"
  ],
  "additionalProperties": false
}
