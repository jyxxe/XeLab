{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "批量 CAS",
  "properties": {
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "expected_schema_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "CAS，创建/删除等另见语义"
    },
    "mode": {
      "type": "string",
      "enum": [
        "replace",
        "patch"
      ],
      "description": "replace 全量替换、patch 只改给定列",
      "default": "replace"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "CAS 行写入",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "description": "可省略以服务端生成；更新必须给出",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "0=必须新建，>0=精确当前版本",
            "default": 0
          },
          "values": {
            "type": "object",
            "description": "数据按列 type 校验",
            "additionalProperties": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ],
              "description": "业务 JSON，按数据列类型继续校验"
            },
            "maxProperties": 128
          }
        },
        "required": [
          "values"
        ],
        "additionalProperties": false
      },
      "description": "同表最多64行",
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "table_id",
    "expected_schema_revision",
    "rows"
  ],
  "additionalProperties": false
}
