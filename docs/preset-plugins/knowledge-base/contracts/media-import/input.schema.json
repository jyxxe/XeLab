{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "导入",
  "properties": {
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "video"
      ],
      "description": "期望模态，必须与实际媒体一致"
    },
    "blob_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "获准源 Blob",
      "format": "uuid",
      "x-xelab-resource-kind": "blob"
    }
  },
  "required": [
    "table_id",
    "kind",
    "blob_id"
  ],
  "additionalProperties": false
}
