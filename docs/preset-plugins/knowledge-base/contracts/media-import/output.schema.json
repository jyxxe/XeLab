{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "已导入插件持久卷的媒体，独立于源 Blob TTL",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "video"
      ],
      "description": "模态"
    },
    "content_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "嗅探并验证的 MIME"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33554432,
      "description": "原始内容长度"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "SHA-256",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reference_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "引用行数"
    }
  },
  "required": [
    "id",
    "table_id",
    "kind",
    "content_type",
    "size_bytes",
    "digest",
    "reference_count"
  ],
  "additionalProperties": false
}
