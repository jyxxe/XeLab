{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "分页表列表",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "私有数据表",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "description": "UUID",
            "format": "uuid"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "description": "UUID",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "description": "账户内唯一表名",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,62}$"
          },
          "schema_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "列与索引配置版本"
          },
          "data_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "行数据变更版本"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "字段定义及观测",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36,
                  "description": "UUID",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "description": "ASCII 列名；下划线开头留给系统",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,62}$"
                },
                "type": {
                  "type": "object",
                  "description": "列类型；int64/decimal 使用字符串 wire 值",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "boolean",
                        "int32",
                        "int64",
                        "float32",
                        "float64",
                        "decimal",
                        "string",
                        "text",
                        "bytes",
                        "date",
                        "timestamp",
                        "uuid",
                        "json",
                        "media",
                        "array"
                      ],
                      "description": "基本列类型"
                    },
                    "precision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 38,
                      "description": "decimal 总位数"
                    },
                    "scale": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 38,
                      "description": "decimal 小数位"
                    },
                    "element_kind": {
                      "type": "string",
                      "enum": [
                        "boolean",
                        "int32",
                        "int64",
                        "float32",
                        "float64",
                        "decimal",
                        "string",
                        "text",
                        "bytes",
                        "date",
                        "timestamp",
                        "uuid",
                        "json"
                      ],
                      "description": "array 元素只允许基本标量，不允许 array/media"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "decimal"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "precision",
                          "scale"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "array"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "element_kind"
                        ]
                      }
                    }
                  ]
                },
                "nullable": {
                  "type": "boolean",
                  "description": "是否允许 null"
                },
                "vector": {
                  "type": "object",
                  "description": "字段级向量索引状态",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "默认 false"
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "配置变更单调递增"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "pending",
                        "building",
                        "ready",
                        "provider_unavailable",
                        "failed"
                      ],
                      "description": "状态"
                    },
                    "dimensions": {
                      "type": "integer",
                      "enum": [
                        128,
                        256,
                        512,
                        768
                      ],
                      "default": 128
                    },
                    "embedding_skill_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 36,
                          "description": "UUID",
                          "format": "uuid"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "首个index候选的兼容诊断字段；查询可能使用另一候选"
                    },
                    "embedding_space_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 71,
                          "description": "SHA-256",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "indexed_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "当前有效行数"
                    },
                    "pending_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "待建立/更新行数"
                    },
                    "failed_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "失败行数"
                    },
                    "index_revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "索引值/状态变化同事务递增，跨generation不重置"
                    },
                    "embedding_routes": {
                      "anyOf": [
                        {
                          "type": "object",
                          "description": "显式配置后固定的候选集合；无运行时自动加候选",
                          "properties": {
                            "query_candidates": {
                              "type": "array",
                              "description": "当前固定的查询优先序",
                              "items": {
                                "type": "object",
                                "description": "通过配置探针验证的固定安装/Skill/契约候选",
                                "properties": {
                                  "skill_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 36,
                                    "description": "UUID",
                                    "format": "uuid"
                                  },
                                  "definition_digest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 71,
                                    "description": "JCS后SHA-256",
                                    "pattern": "^sha256:[a-f0-9]{64}$"
                                  },
                                  "installation_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 36,
                                    "description": "UUID",
                                    "format": "uuid"
                                  },
                                  "plugin_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "description": "插件稳定 ID；不含版本",
                                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
                                    "example": "org.xelab.echo"
                                  },
                                  "contract": {
                                    "type": "object",
                                    "description": "不可变能力契约引用",
                                    "additionalProperties": false,
                                    "properties": {
                                      "name": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128,
                                        "description": "能力名称",
                                        "pattern": "^[a-z][a-z0-9.-]+$"
                                      },
                                      "version": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128,
                                        "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
                                        "example": "1.0.0",
                                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
                                      },
                                      "schema_digest": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 71,
                                        "description": "制品或内容 SHA-256 摘要",
                                        "pattern": "^sha256:[a-f0-9]{64}$",
                                        "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                                      }
                                    },
                                    "required": [
                                      "name",
                                      "version",
                                      "schema_digest"
                                    ]
                                  }
                                },
                                "required": [
                                  "skill_id",
                                  "definition_digest",
                                  "installation_id",
                                  "plugin_id",
                                  "contract"
                                ],
                                "additionalProperties": false
                              },
                              "minItems": 1,
                              "maxItems": 8
                            },
                            "index_candidates": {
                              "type": "array",
                              "description": "当前固定的建立优先序",
                              "items": {
                                "type": "object",
                                "description": "通过配置探针验证的固定安装/Skill/契约候选",
                                "properties": {
                                  "skill_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 36,
                                    "description": "UUID",
                                    "format": "uuid"
                                  },
                                  "definition_digest": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 71,
                                    "description": "JCS后SHA-256",
                                    "pattern": "^sha256:[a-f0-9]{64}$"
                                  },
                                  "installation_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 36,
                                    "description": "UUID",
                                    "format": "uuid"
                                  },
                                  "plugin_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "description": "插件稳定 ID；不含版本",
                                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
                                    "example": "org.xelab.echo"
                                  },
                                  "contract": {
                                    "type": "object",
                                    "description": "不可变能力契约引用",
                                    "additionalProperties": false,
                                    "properties": {
                                      "name": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128,
                                        "description": "能力名称",
                                        "pattern": "^[a-z][a-z0-9.-]+$"
                                      },
                                      "version": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128,
                                        "description": "SemVer 2.0.0；版本约束语法见插件版本文档",
                                        "example": "1.0.0",
                                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
                                      },
                                      "schema_digest": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 71,
                                        "description": "制品或内容 SHA-256 摘要",
                                        "pattern": "^sha256:[a-f0-9]{64}$",
                                        "example": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                                      }
                                    },
                                    "required": [
                                      "name",
                                      "version",
                                      "schema_digest"
                                    ]
                                  }
                                },
                                "required": [
                                  "skill_id",
                                  "definition_digest",
                                  "installation_id",
                                  "plugin_id",
                                  "contract"
                                ],
                                "additionalProperties": false
                              },
                              "minItems": 1,
                              "maxItems": 8
                            },
                            "allow_fallback": {
                              "type": "boolean"
                            },
                            "route_digest": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 71,
                              "description": "JCS后SHA-256",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "query_candidates",
                            "index_candidates",
                            "allow_fallback",
                            "route_digest"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "从未配置时null；禁用后保留固定路由"
                    }
                  },
                  "required": [
                    "enabled",
                    "generation",
                    "state",
                    "dimensions",
                    "embedding_skill_id",
                    "embedding_space_id",
                    "indexed_rows",
                    "pending_rows",
                    "failed_rows",
                    "index_revision",
                    "embedding_routes"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "nullable",
                "vector"
              ],
              "additionalProperties": false
            },
            "description": "按创建顺序",
            "minItems": 1,
            "maxItems": 128
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "未删除行数"
          },
          "indexer_account_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 36,
                "description": "显式批准只做索引维护的服务账户",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "owner_id",
          "name",
          "schema_revision",
          "data_revision",
          "fields",
          "row_count",
          "indexer_account_id"
        ],
        "additionalProperties": false
      },
      "description": "对象",
      "minItems": 0,
      "maxItems": 200
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "15min 游标"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
