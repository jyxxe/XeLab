{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "有版本的变更结果",
  "properties": {
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "UUID",
      "format": "uuid"
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "当前版本"
    },
    "data_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "当前数据版本"
    },
    "affected_rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "影响行数"
    }
  },
  "required": [
    "table_id",
    "schema_revision",
    "data_revision",
    "affected_rows"
  ],
  "additionalProperties": false
}
