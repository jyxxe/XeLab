{
  "name": "org.xelab.micro-plugin-runtime.micro.00000000-0000-4000-8000-000000000101.run",
  "version": "1.0.0",
  "description": "网页搜索API转发，按已批准优先级串行fallback",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 10
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "description": "最多600码点/75空白分词，仅query和limit，无URL或认证字段"
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "provider": {
        "type": "string",
        "enum": [
          "brave",
          "tavily"
        ]
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "description": {
              "type": "string",
              "minLength": 0,
              "maxLength": 8192
            }
          },
          "required": [
            "title",
            "url",
            "description"
          ],
          "additionalProperties": false
        },
        "maxItems": 20
      },
      "count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      },
      "fallback_used": {
        "type": "boolean"
      },
      "attempts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "brave",
                "tavily"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "success",
                "not_sent",
                "rate_limited",
                "upstream_error",
                "auth_rejected",
                "invalid_response"
              ]
            },
            "http_status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "provider",
            "outcome",
            "http_status"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 3
      },
      "usage": {
        "type": "object",
        "properties": {
          "external_requests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "potentially_billed_requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "external_requests",
          "potentially_billed_requests"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "query",
      "provider",
      "items",
      "count",
      "fallback_used",
      "attempts",
      "usage"
    ],
    "additionalProperties": false
  },
  "stream_item_schema": null,
  "target": {
    "kind": "micro",
    "plugin_id": "org.xelab.micro-plugin-runtime",
    "micro_version_id": "00000000-0000-4000-8000-000000000100",
    "micro_deployment_id": "00000000-0000-4000-8000-000000000101",
    "package_digest": "sha256:480719e58264c84b63c1ba8bbf7ae5e43ec167e65981b5bb7b7bbf66c8b733f2"
  },
  "mapping": "identity",
  "maximum_timeout_ms": 15000,
  "input_blobs": false,
  "tags": [
    "micro",
    "web-search",
    "http-forward"
  ]
}
