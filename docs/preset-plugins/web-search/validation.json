            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "brave",
                    "tavily"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "success",
                    "not_sent",
