              },
              "search_depth": {
                "const": "basic"
              },
              "topic": {
                "const": "general"
              },
              "auto_parameters": {
                "const": false
              },
              "include_answer": {
                "const": false
              },
              "include_raw_content": {
                "const": false
              },
              "include_images": {
                "const": false
              },
              "include_usage": {
                "const": true
              }
            },
            "required": [
