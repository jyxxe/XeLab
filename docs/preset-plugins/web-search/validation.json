            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 1024
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
