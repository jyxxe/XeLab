{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-xelab-status": "planned",
  "type": "object",
  "description": "",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "minItems": 1,
      "maxItems": 128
    },
    "mode": {
      "type": "string",
      "enum": [
        "shallow",
        "deep"
