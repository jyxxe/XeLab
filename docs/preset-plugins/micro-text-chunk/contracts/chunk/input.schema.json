{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-xelab-status": "planned",
  "type": "object",
  "description": "",
  "properties": {
    "text": {
      "type": "string",
      "description": "",
      "minLength": 0,
      "maxLength": 1048576
    },
    "mode": {
      "type": "string",
      "enum": [
        "characters",
        "paragraphs",
        "tokens",
        "tokens-estimate"
      ],
      "description": "",
      "default": "characters"
    },
    "size": {
      "type": "integer",
      "description": "",
      "minimum": 1,
      "maximum": 1048576
    },
    "overlap": {
      "type": "integer",
      "description": "",
      "minimum": 0,
      "maximum": 1048575,
      "default": 0
    },
    "tokenizer_id": {
      "type": "string",
      "description": "",
      "minLength": 1,
      "maxLength": 128
    },
    "tokenizer_version": {
      "type": "string",
      "description": "",
      "minLength": 1,
      "maxLength": 128
    },
    "estimator_id": {
      "const": "utf8-div4-v1",
      "default": "utf8-div4-v1"
    },
    "estimator_version": {
      "const": "0.1.0",
      "default": "0.1.0"
    }
  },
  "required": [
    "text",
    "size"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "tokens"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "tokenizer_id",
          "tokenizer_version"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "tokenizer_id"
              ]
            },
            {
              "required": [
                "tokenizer_version"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "tokens-estimate"
          }
        },
        "required": [
          "mode"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "estimator_id"
              ]
            },
            {
              "required": [
                "estimator_version"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "paragraphs"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "overlap": {
            "const": 0
          }
        }
      }
    }
  ]
}
