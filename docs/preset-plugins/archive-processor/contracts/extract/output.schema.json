{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-xelab-status": "planned",
  "type": "object",
  "description": "",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "",
        "properties": {
          "path": {
            "type": "string",
            "description": "相对规范路径，无dot/链接/设备节点",
            "minLength": 1,
            "maxLength": 1024
          },
          "blob_id": {
            "type": "string",
            "description": "UUID",
            "minLength": 1,
            "maxLength": 36,
            "format": "uuid"
          },
          "size_bytes": {
            "type": "integer",
            "description": "",
            "minimum": 0,
            "maximum": 67108864
          },
          "digest": {
            "type": "string",
            "description": "SHA256",
            "minLength": 1,
            "maxLength": 71,
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "content_type": {
            "type": "string",
            "description": "",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "path",
          "blob_id",
          "size_bytes",
          "digest",
          "content_type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "total_bytes": {
      "type": "integer",
      "description": "",
      "minimum": 0,
      "maximum": 67108864
    }
  },
  "required": [
    "files",
    "total_bytes"
  ],
  "additionalProperties": false
}
