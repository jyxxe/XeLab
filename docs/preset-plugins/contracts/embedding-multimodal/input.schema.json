{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "多模态 embedding，单请求单项",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "按顺序组合为一条向量",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "description": "文本片段",
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536,
                      "description": "原始文本，不接受媒体控制占位符"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "description": "受控媒体输入；不接受路径、外部 URL、Base64 大对象",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "image",
                        "audio",
                        "video"
                      ],
                      "description": "模态"
                    },
                    "blob_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 36,
                      "description": "调用者获准读取的 Blob",
                      "format": "uuid",
                      "x-xelab-resource-kind": "blob"
                    }
                  },
                  "required": [
                    "type",
                    "blob_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "文本和媒体序列",
            "minItems": 1,
            "maxItems": 8
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "仅 document 用途"
          }
        },
        "required": [
          "parts"
        ],
        "additionalProperties": false
      },
      "description": "单项",
      "minItems": 1,
      "maxItems": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "retrieval_query",
        "retrieval_document",
        "semantic_similarity"
      ],
      "description": "任务用途，由插件固定映射前缀",
      "default": "semantic_similarity"
    },
    "dimensions": {
      "type": "integer",
      "enum": [
        128,
        256,
        512,
        768
      ],
      "default": 768,
      "description": "先保留前 d 维再 L2 归一化"
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
