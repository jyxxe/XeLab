{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "向量和兼容性标识",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "对应一项输入",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "description": "从 0 开始"
          },
          "embedding": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "有限 float32 值，拒绝 NaN/Infinity"
            },
            "description": "维度必须与 dimensions 相同",
            "minItems": 128,
            "maxItems": 768
          }
        },
        "required": [
          "index",
          "embedding"
        ],
        "additionalProperties": false
      },
      "description": "顺序与输入相同",
      "minItems": 1,
      "maxItems": 16
    },
    "dimensions": {
      "type": "integer",
      "enum": [
        128,
        256,
        512,
        768
      ]
    },
    "normalized": {
      "const": true
    },
    "model": {
      "const": "google/embeddinggemma-2"
    },
    "model_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "构建时锁定的上游 commit",
      "pattern": "^[a-f0-9]{40}$"
    },
    "embedding_space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "description": "不含 CPU/并发数的向量空间指纹",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "实际插件 ID"
    },
    "usage": {
      "type": "object",
      "description": "本批输入计量，不是模型性能承诺",
      "properties": {
        "input_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "项数"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072,
          "description": "含前缀与模态的总计"
        }
      },
      "required": [
        "input_items",
        "input_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data",
    "dimensions",
    "normalized",
    "model",
    "model_revision",
    "embedding_space_id",
    "profile_id",
    "usage"
  ],
  "additionalProperties": false
}
