            "minItems": 0,
            "maxItems": 32
          },
          "author_name": {
            "type": "string",
            "description": "",
            "minLength": 0,
            "maxLength": 256
          },
          "authored_at": {
            "type": "string",
            "description": "",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "subject": {
            "type": "string",
            "description": "",
            "minLength": 0,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "parents",
          "author_name",
          "authored_at",
          "subject"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
